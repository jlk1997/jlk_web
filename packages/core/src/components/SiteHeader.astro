---
import type { Locale } from "../data/facts";
import { localizeHref, type NavItem } from "../data/nav";

interface Props {
  locale: Locale;
  brand: string;
  brandHref: string;
  items: NavItem[];
  path: string;
  ctaHref: string;
  ctaLabel: string;
}

const { locale, brand, brandHref, items, path, ctaHref, ctaLabel } = Astro.props;
const other = locale === "zh" ? "EN" : "中文";
const otherHref = locale === "zh"
  ? (path === "/" ? "/en" : `/en${path}`)
  : (path.replace(/^\/en/, "") || "/");

function current(href: string) {
  if (href.startsWith("http")) return false;
  const localized = localizeHref(href, locale);
  const hashAt = localized.indexOf("#");
  const bare = (hashAt >= 0 ? localized.slice(0, hashAt) : localized) || "/";
  if (hashAt >= 0) return path === bare;
  if (bare === "/" || bare === "/en") return path === bare;
  return path === bare || path.startsWith(`${bare}/`);
}
---

<a class="skip" href="#main">{locale === "zh" ? "跳到正文" : "Skip to content"}</a>
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={localizeHref(brandHref, locale)}>{brand}</a>
    <nav class="nav" data-nav>
      {items.map((item) => (
        <a
          href={item.external ? item.href : localizeHref(item.href, locale)}
          aria-current={current(item.href) ? "page" : undefined}
          rel={item.external ? "noopener" : undefined}
        >
          {item.label[locale]}
        </a>
      ))}
    </nav>
    <div class="header-tools">
      <a class="lang" href={otherHref} hreflang={locale === "zh" ? "en" : "zh-CN"}>{other}</a>
      <a class="btn btn-solid" href={localizeHref(ctaHref, locale)}>{ctaLabel}</a>
      <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false">
        {locale === "zh" ? "菜单" : "Menu"}
      </button>
    </div>
  </div>
</header>
<script>
  function bindNav() {
    const btn = document.querySelector("[data-nav-toggle]");
    const nav = document.querySelector("[data-nav]");
    if (!btn || !nav || btn.dataset.bound === "1") return;
    btn.dataset.bound = "1";
    btn.addEventListener("click", () => {
      const open = nav.classList.toggle("is-open");
      btn.setAttribute("aria-expanded", open ? "true" : "false");
    });
  }
  bindNav();
  document.addEventListener("astro:page-load", bindNav);
</script>
