---
interface Item {
  label: string;
  text: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<aside class="brief">
  <dl>
    {
      items.map((item) => (
        <div>
          <dt>{item.label}</dt>
          <dd>{item.text}</dd>
        </div>
      ))
    }
  </dl>
</aside>
