---
import type { Locale } from "../data/facts";

interface Props {
  locale: Locale;
  items: Array<{ name: string; href: string }>;
}

const { locale, items } = Astro.props;
---

<nav class="crumbs" aria-label={locale === "zh" ? "面包屑" : "Breadcrumb"}>
  <ol>
    {
      items.map((item, i) => (
        <li>
          {i < items.length - 1 ? <a href={item.href}>{item.name}</a> : <span aria-current="page">{item.name}</span>}
        </li>
      ))
    }
  </ol>
</nav>
