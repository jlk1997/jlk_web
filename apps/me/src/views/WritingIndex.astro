---
import Base from "../layouts/Base.astro";
import AnswerBlock from "@jlk/core/components/AnswerBlock.astro";
import type { Locale } from "@jlk/core/data/facts";
import { localizeHref } from "@jlk/core/data/nav";
import { getCollection } from "astro:content";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const path = locale === "zh" ? "/writing" : "/en/writing";
const posts = (await getCollection("writing"))
  .filter((p) => p.data.locale === locale)
  .sort((a, b) => b.data.datePublished.localeCompare(a.data.datePublished));
---

<Base
  locale={locale}
  path={path}
  type="CollectionPage"
  title={locale === "zh" ? "江李铠的文章" : "Writing by Jiang Likai"}
  description={locale === "zh" ? "长文。作者固定指向江李铠这个人。" : "Essays. The author is always Jiang Likai."}
  breadcrumbs={[
    { name: locale === "zh" ? "首页" : "Home", path: locale === "zh" ? "/" : "/en" },
    { name: locale === "zh" ? "文章" : "Writing", path },
  ]}
>
  <section class="section">
    <div class="narrow">
      <p class="eyebrow">{locale === "zh" ? "文章" : "Writing"}</p>
      <h1>{locale === "zh" ? "长文，不发鸡汤。" : "Longer than a slogan."}</h1>
      <AnswerBlock
        locale={locale}
        answer={locale === "zh" ? "先写三篇：GEO、Agent、宠物数字化。" : "Three to start: GEO, agents, pet digitalization."}
      />
      <div style="display:flex;flex-direction:column;gap:1rem">
        {posts.map((post) => (
          <a class="card" href={localizeHref(`/writing/${post.data.article}`, locale)} style="text-decoration:none">
            <p class="eyebrow">{post.data.datePublished}</p>
            <h2>{post.data.title}</h2>
            <p class="muted">{post.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
